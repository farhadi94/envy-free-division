EnvyFreeResearch.Full.Chores.Main.deterministic_chores {n : ℕ} (hn : 3 ≤ n)
  (cost : EnvyFreeResearch.Full.Chores.Population.Costs n)
  (oracle : EnvyFreeResearch.Full.AdaptiveOracle.Policy (EnvyFreeResearch.Full.IntervalOracle.Query (Fin n)) ℝ)
  (hpolicy :
    EnvyFreeResearch.Full.AdaptiveOracle.IsLegalPolicy (EnvyFreeResearch.Full.Chores.measureProfile cost.measure)
      oracle) :
  ∃ out trace,
    EnvyFreeResearch.Full.AdaptiveOracle.run (EnvyFreeResearch.Full.Chores.Main.program n ⋯).protocol oracle ()
          (EnvyFreeResearch.Full.Chores.Main.bound n) [] =
        { answered := trace, stop := EnvyFreeResearch.Full.OracleProtocol.Stop.returned out } ∧
      List.length trace ≤ EnvyFreeResearch.Full.Chores.Main.bound n ∧
        EnvyFreeResearch.Full.Chores.OrderedUnion.virtualCuts trace ≤ EnvyFreeResearch.Full.Chores.Main.bound n ∧
          (Pairwise fun i j => Disjoint (out.share i) (out.share j)) ∧
            ⋃ i, out.share i = Set.Icc 0 1 ∧
              (∀ (i j : Fin n), (cost.measure i).real (out.share i) ≤ (cost.measure i).real (out.share j)) ∧
                (∀ (i : Fin n), MeasurableSet (out.share i)) ∧
