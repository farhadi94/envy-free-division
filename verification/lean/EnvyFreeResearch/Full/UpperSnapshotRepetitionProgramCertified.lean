import EnvyFreeResearch.Full.UpperSnapshotRepetitionPacket
import EnvyFreeResearch.Full.UpperSnapshotRepetitionProbability
import EnvyFreeResearch.Full.UpperSnapshotRepetitionBridge
import EnvyFreeResearch.Full.ProgramMeasurable

/-! Certification concerns the actual program's next action on every coded
history, including transcripts not generated by any legal response policy. -/
noncomputable section
open MeasureTheory
namespace EnvyFreeResearch.Full.UpperSnapshotRepetition
open Chores.QueryProgram ProgramMeasurable ProtocolMeasurable
variable {X State Draw Query Reply Output : Type} [MeasurableSpace X] [MeasurableSpace State]
  [MeasurableSpace Draw] [MeasurableSpace Query] [MeasurableSpace Reply] [MeasurableSpace Output]

theorem program_family_certified (attempt : X → State → Draw → Program Query Reply (State × Option Output))
    (hstep : Certified (fun p : X × (State × Draw) => attempt p.1 p.2.1 p.2.2)) (m : ℕ) :
    Certified (fun p : X × (State × Tape Draw m) => program (attempt p.1) (drawList p.2.2) p.2.1) := by
  induction m with
  | zero => exact Certified.returned _ ((measurable_fst.comp measurable_snd).prodMk measurable_const)
  | succ m ih =>
    have hsd : Measurable (fun p : X × (State × (Draw × Tape Draw m)) => (p.1,(p.2.1,p.2.2.1))) :=
      measurable_fst.prodMk ((measurable_fst.comp measurable_snd).prodMk
        (measurable_fst.comp (measurable_snd.comp measurable_snd)))
    have hfirst := hstep.comp _ hsd
    have hrest := ih.comp
      (fun p : (X × (State × (Draw × Tape Draw m))) × (State × Option Output) =>
        (p.1.1,(p.2.1,p.1.2.2.2)))
      ((measurable_fst.comp measurable_fst).prodMk ((measurable_fst.comp measurable_snd).prodMk
        (measurable_snd.comp (measurable_snd.comp (measurable_snd.comp measurable_fst)))))
    have hsome : Certified (fun p : ((X × (State × (Draw × Tape Draw m))) × (State × Option Output)) × Output =>
        (Program.returned (p.1.2.1,some p.2) : Program Query Reply (State × Option Output))) :=
      Certified.returned _ ((measurable_fst.comp (measurable_snd.comp measurable_fst)).prodMk
        (measurable_some.comp measurable_snd))
    exact hfirst.bind _ (Certified.optionCases _ (measurable_snd.comp measurable_snd) _ _ hsome hrest)

theorem packetAttempt_family_certified
    (attempt : X → State → Draw → Program Query Reply (State × Option Output))
    (hstep : Certified (fun p : X × (State × Draw) => attempt p.1 p.2.1 p.2.2)) :
    Certified (fun p : X × (State × Draw) => packetAttempt (attempt p.1) p.2.1 p.2.2) := by
  have hm := measurable_option_cases
    (present := fun (p : (X × (State × Draw)) × (State × Option Output)) (a : Output) =>
      some (p.1.2.1,p.1.2.2,a))
    (absent := fun _ : (X × (State × Draw)) × (State × Option Output) =>
      (none : Option (Packet State Draw Output)))
    (measurable_snd.comp measurable_snd)
    (measurable_some.comp
      ((measurable_fst.comp (measurable_snd.comp (measurable_fst.comp measurable_fst))).prodMk
        ((measurable_snd.comp (measurable_snd.comp (measurable_fst.comp measurable_fst))).prodMk measurable_snd)))
    measurable_const
  have hp : Measurable (fun p : (X × (State × Draw)) × (State × Option Output) =>
      (p.2.1,p.2.2.map (fun a => (p.1.2.1,p.1.2.2,a)))) := by
    convert (measurable_fst.comp measurable_snd).prodMk hm using 1
    funext p
    simp only [Function.comp_def]
    cases p.2.2 <;> rfl
  exact hstep.bind _ (Certified.returned _ hp)

end EnvyFreeResearch.Full.UpperSnapshotRepetition
